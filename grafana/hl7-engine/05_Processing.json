{
  "uid": "hl7-proc",
  "title": "05_Processing",
  "tags": ["hl7", "processing"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "style": "dark",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Messages Processed (1m rate)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
          { "refId": "A", "expr": "rate(hl7_processing_messages_total[1m])" }
      ],
      "fieldConfig": {
          "defaults": {
          "unit": "ops",
          "decimals": 2,
          "thresholds": {
              "mode": "absolute",
              "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
              ]
          }
          },
          "overrides": []
      },
      "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "horizontal",
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Processing Errors (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
          { "refId": "A", "expr": "increase(hl7_proc_stage_errors_total{stage='routing'}[5m]) + increase(hl7_proc_stage_errors_total{stage='file_write'}[5m]) + increase(hl7_proc_stage_errors_total{stage='db_insert'}[5m])" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Processing Latency p95/p99",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 4 },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hl7_processing_latency_seconds_p95_seconds",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "hl7_processing_latency_seconds_p99_seconds",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.2 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Processing Stage Errors (5m)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 4 },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(hl7_proc_stage_errors_total[5m])",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Processing Time per Stage (p95)",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 10 },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hl7_proc_stage_duration_seconds_p95_seconds",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Processing Queue Depth",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 10 },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hl7_processing_queue_depth",
          "legendFormat": "queue depth"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    }
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  }
}