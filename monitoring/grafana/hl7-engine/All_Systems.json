{
  "uid": "hl7-all",
  "title": "All_Systems",
  "tags": ["hl7", "overview", "all-systems"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "style": "dark",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Throughput (1m rate)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hl7_messages_received_total[1m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Processed Throughput (1m rate)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hl7_messages_processed_total[1m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Global Error Rate (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(hl7_mllp_read_errors_total[5m]) or increase(hl7_mllp_frame_errors_total[5m]) or increase(hl7_mllp_connection_errors_total[5m]) or increase(hl7_mllp_write_errors_total[5m]) or increase(hl7_parser_parse_errors_total[5m]) or increase(hl7_parser_validation_errors_total[5m]) or increase(hl7_router_routing_errors_total[5m]) or increase(hl7_store_write_errors_total[5m]) or increase(hl7_proc_stage_errors_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "ACK Success Rate (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hl7_ack_generated_total{code=\"AA\"}[5m])) / sum(rate(hl7_ack_generated_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Subsystem Latency Summary (p95)",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 4 },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        { "refId": "A", "expr": "hl7_mllp_latency_p95_seconds", "legendFormat": "MLLP" },
        { "refId": "B", "expr": "hl7_parser_latency_seconds_p95_seconds", "legendFormat": "Parser" },
        { "refId": "C", "expr": "hl7_processing_latency_seconds_p95_seconds", "legendFormat": "Processing" },
        { "refId": "D", "expr": "hl7_proc_stage_duration_seconds_p95_seconds{stage='routing'}", "legendFormat": "Router" },
        { "refId": "E", "expr": "hl7_store_write_latency_p95_seconds", "legendFormat": "Storage" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3 }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Queue Depth Summary",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 4 },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        { "refId": "A", "expr": "hl7_processing_queue_depth", "legendFormat": "Processing" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none" }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Subsystem Error Breakdown (5m)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 10 },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        { "refId": "A", "expr": "increase(hl7_mllp_read_errors_total[5m]) + + increase(hl7_mllp_frame_errors_total[5m]) + increase(hl7_mllp_connection_errors_total[5m]) + increase(hl7_mllp_write_errors_total[5m])", "legendFormat": "MLLP" },
        { "refId": "B", "expr": "increase(hl7_parser_parse_errors_total[5m]) + increase(hl7_parser_validation_errors_total[5m])", "legendFormat": "Parser" },
        { "refId": "C", "expr": "increase(hl7_proc_stage_errors_total{stage='routing'}[5m]) + increase(hl7_proc_stage_errors_total{stage='file_write'}[5m]) + increase(hl7_proc_stage_errors_total{stage='db_insert'}[5m])", "legendFormat": "Processing" },
        { "refId": "D", "expr": "increase(hl7_router_routing_errors_total[5m])", "legendFormat": "Router" },
        { "refId": "E", "expr": "increase(hl7_store_write_errors_total[5m])", "legendFormat": "Storage" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none" }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    }
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  }
}